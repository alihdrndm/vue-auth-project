# Copy to backend/.env for local overrides. Every value below is the development default.
# Never commit backend/.env.

# Django. DJANGO_SECRET_KEY is required (and must differ from the default) in production.
DJANGO_SECRET_KEY=dev-insecure-secret-key-change-me
# false in production
DJANGO_DEBUG=true
# Comma-separated host names the API answers to
ALLOWED_HOSTS=localhost,127.0.0.1
# The SPA's origin; added to CSRF_TRUSTED_ORIGINS
FRONTEND_ORIGIN=http://localhost:3110

# PostgreSQL (local Compose service on port 5452; Supabase session pooler in production)
DATABASE_URL=postgres://eingang:eingang@localhost:5452/eingang

# File storage: local (backend/.local-media/) or s3 (Supabase Storage S3 endpoint)
STORAGE_BACKEND=local
S3_ENDPOINT_URL=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=documents

# Proxy hops in front of the API (Vercel + Railway) whose X-Forwarded-For entries the rate
# limits trust; 0 locally. Measured at deployment, see docs/DEPLOY.md.
TRUSTED_PROXY_HOPS=0

# Temporal (temporal.railway.internal:7233 on Railway)
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=eingang

# Uploads and the public sandbox
# 4 MB per file
MAX_UPLOAD_BYTES=4194304
SANDBOX_TTL_HOURS=24
# Sandboxes created per day, all visitors together
SANDBOX_DAILY_LIMIT=50
# Uploaded files per sandbox
SANDBOX_MAX_UPLOADS=10
# All sandboxes' files together (300 MB)
SANDBOX_STORAGE_BUDGET_BYTES=314572800

# PDF-versus-XML comparison for hybrid PDFs
COMPARE_HYBRID_PDF=true

# Password of the local seed users (pnpm seed); never used in production
SEED_PASSWORD=eingang-dev

# Optional IMAP intake
MAILBOX_ENABLED=false
MAILBOX_HOST=
MAILBOX_PORT=993
MAILBOX_USER=
MAILBOX_PASSWORD=
MAILBOX_ORG_SLUG=

# LLM master switch. The remaining LLM_* and OPENAI_* settings are added with the LLM layer (M5).
LLM_ENABLED=false
