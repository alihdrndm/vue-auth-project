[importlinter]
root_packages =
    eingang
    einvoice
include_external_packages = True

[importlinter:contract:einvoice-is-pure]
name = einvoice-is-pure
type = forbidden
source_modules =
    einvoice
forbidden_modules =
    django
    rest_framework
    eingang
    temporalio
    openai

[importlinter:contract:workflows-are-deterministic]
name = workflows-are-deterministic
type = forbidden
source_modules =
    eingang.workflows
forbidden_modules =
    django
    rest_framework
    psycopg
    httpx
    openai
    einvoice
