[importlinter]
root_packages =
    eingang
    einvoice
    accounts
    invoices
    suppliers
    exports
    llm
    sandbox
include_external_packages = True

[importlinter:contract:einvoice-is-pure]
name = einvoice-is-pure
type = forbidden
source_modules =
    einvoice
forbidden_modules =
    django
    rest_framework
    eingang
    accounts
    invoices
    suppliers
    exports
    llm
    sandbox
    temporalio
    openai

[importlinter:contract:workflows-are-deterministic]
name = workflows-are-deterministic
type = forbidden
source_modules =
    eingang.workflows
forbidden_modules =
    django
    rest_framework
    psycopg
    httpx
    openai
    einvoice
    accounts
    invoices
    suppliers
    exports
    llm
    sandbox

[importlinter:contract:api-stays-light]
name = api-stays-light
type = forbidden
source_modules =
    *.api
    *.serializers
    invoices.review_api
    invoices.rules_api
    invoices.rules_serializers
    invoices.stats_api
    invoices.stats_serializers
forbidden_modules =
    einvoice.validate
    einvoice.visualize
    einvoice.pdf
    saxonche
    pdfplumber
    pypdf
    facturx
    openai
allow_indirect_imports = False

[importlinter:contract:one-llm-door]
name = one-llm-door
type = forbidden
source_modules =
    eingang
    einvoice
    accounts
    invoices
    suppliers
    exports
    llm
    sandbox
forbidden_modules =
    openai
ignore_imports =
    llm.client -> openai
unmatched_ignore_imports_alerting = none
